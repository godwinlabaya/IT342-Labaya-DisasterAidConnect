<?xml version="1.0" encoding="utf-8"?>
<!-- activity_admin_dashboard.xml — mirrors web admin dashboard exactly -->
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorBackground">

    <!-- Navy top bar -->
    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:background="@color/colorNavy"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="20dp"
        android:paddingEnd="16dp"
        android:elevation="4dp">

        <!-- Logo -->
        <FrameLayout
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/bg_logo_box"
            android:layout_marginEnd="10dp">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="D"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold"/>
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="DISASTER"
                    android:textColor="@color/colorPrimary"
                    android:textSize="13sp"
                    android:textStyle="bold"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="AIDCONNECT"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp"
                    android:textStyle="bold"/>
            </LinearLayout>
            <!-- ADMIN PANEL badge — mirrors web "ADMIN PANEL" label under logo -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ADMIN PANEL"
                android:textColor="#FFFFFF"
                android:textSize="9sp"
                android:letterSpacing="0.1"
                android:background="@drawable/bg_admin_badge"
                android:paddingStart="6dp"
                android:paddingEnd="6dp"
                android:paddingTop="2dp"
                android:paddingBottom="2dp"
                android:layout_marginTop="2dp"/>
        </LinearLayout>

        <!-- Admin avatar -->
        <FrameLayout
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/bg_avatar">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="AD"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:textStyle="bold"/>
        </FrameLayout>
    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="64dp"
        android:layout_marginBottom="56dp"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- Header: ADMIN PANEL label + Welcome Admin! -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ADMIN PANEL"
                android:textColor="@color/colorTextMuted"
                android:textSize="11sp"
                android:letterSpacing="0.1"
                android:textAllCaps="true"
                android:layout_marginBottom="4dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Welcome, Admin!"
                android:textColor="@color/colorTextPrimary"
                android:textSize="26sp"
                android:textStyle="bold"
                android:layout_marginBottom="4dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Here's an overview of the entire system"
                android:textColor="@color/colorTextSecondary"
                android:textSize="13sp"
                android:layout_marginBottom="24dp"/>

            <!-- 4 Stat Cards (2×2) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="20dp">

                <!-- Row 1 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="8dp">

                    <!-- Total Disasters -->
                    <LinearLayout
                        android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:background="@drawable/bg_card"
                        android:orientation="horizontal" android:gravity="center_vertical"
                        android:padding="16dp" android:layout_marginEnd="6dp">
                        <FrameLayout
                            android:layout_width="40dp" android:layout_height="40dp"
                            android:background="@drawable/bg_stat_icon_red"
                            android:layout_marginEnd="12dp">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:layout_gravity="center" android:text="🗺️" android:textSize="18sp"/>
                        </FrameLayout>
                        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:orientation="vertical">
                            <TextView android:id="@+id/tvTotalDisasters"
                                android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="—" android:textColor="@color/colorTextPrimary"
                                android:textSize="28sp" android:textStyle="bold"/>
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="TOTAL DISASTERS" android:textColor="@color/colorTextMuted"
                                android:textSize="10sp" android:textAllCaps="true" android:letterSpacing="0.06"/>
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Map Points -->
                    <LinearLayout
                        android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:background="@drawable/bg_card"
                        android:orientation="horizontal" android:gravity="center_vertical"
                        android:padding="16dp" android:layout_marginStart="6dp">
                        <FrameLayout
                            android:layout_width="40dp" android:layout_height="40dp"
                            android:background="@drawable/bg_stat_icon_blue"
                            android:layout_marginEnd="12dp">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:layout_gravity="center" android:text="📍" android:textSize="18sp"/>
                        </FrameLayout>
                        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:orientation="vertical">
                            <TextView android:id="@+id/tvMapPoints"
                                android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="—" android:textColor="@color/colorTextPrimary"
                                android:textSize="28sp" android:textStyle="bold"/>
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="MAP POINTS" android:textColor="@color/colorTextMuted"
                                android:textSize="10sp" android:textAllCaps="true" android:letterSpacing="0.06"/>
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>

                <!-- Row 2 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <!-- Total Donations -->
                    <LinearLayout
                        android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:background="@drawable/bg_card"
                        android:orientation="horizontal" android:gravity="center_vertical"
                        android:padding="16dp" android:layout_marginEnd="6dp">
                        <FrameLayout
                            android:layout_width="40dp" android:layout_height="40dp"
                            android:background="@drawable/bg_stat_icon_purple"
                            android:layout_marginEnd="12dp">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:layout_gravity="center" android:text="💙" android:textSize="18sp"/>
                        </FrameLayout>
                        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:orientation="vertical">
                            <TextView android:id="@+id/tvTotalDonations"
                                android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="—" android:textColor="@color/colorTextPrimary"
                                android:textSize="28sp" android:textStyle="bold"/>
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="TOTAL DONATIONS" android:textColor="@color/colorTextMuted"
                                android:textSize="10sp" android:textAllCaps="true" android:letterSpacing="0.06"/>
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Registered Users -->
                    <LinearLayout
                        android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:background="@drawable/bg_card"
                        android:orientation="horizontal" android:gravity="center_vertical"
                        android:padding="16dp" android:layout_marginStart="6dp">
                        <FrameLayout
                            android:layout_width="40dp" android:layout_height="40dp"
                            android:background="@drawable/bg_stat_icon_green"
                            android:layout_marginEnd="12dp">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:layout_gravity="center" android:text="👥" android:textSize="18sp"/>
                        </FrameLayout>
                        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:orientation="vertical">
                            <TextView android:id="@+id/tvRegisteredUsers"
                                android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="—" android:textColor="@color/colorTextPrimary"
                                android:textSize="28sp" android:textStyle="bold"/>
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="REGISTERED USERS" android:textColor="@color/colorTextMuted"
                                android:textSize="10sp" android:textAllCaps="true" android:letterSpacing="0.06"/>
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- 4 Navigation Cards (2×2) — mirrors web quick-nav cards -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- Row 1 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="8dp">

                    <!-- Manage Disasters -->
                    <LinearLayout
                        android:id="@+id/cardDisasters"
                        android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:background="@drawable/bg_nav_card"
                        android:orientation="horizontal" android:gravity="center_vertical"
                        android:padding="16dp" android:layout_marginEnd="6dp"
                        android:clickable="true" android:focusable="true">
                        <FrameLayout
                            android:layout_width="40dp" android:layout_height="40dp"
                            android:background="@drawable/bg_stat_icon_red"
                            android:layout_marginEnd="12dp">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:layout_gravity="center" android:text="🗺️" android:textSize="18sp"/>
                        </FrameLayout>
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_weight="1" android:orientation="vertical">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="Manage Disasters"
                                android:textColor="@color/colorTextPrimary"
                                android:textSize="14sp" android:textStyle="bold"/>
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="View and delete disaster reports"
                                android:textColor="@color/colorTextMuted" android:textSize="11sp"/>
                        </LinearLayout>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="›" android:textColor="@color/colorTextMuted" android:textSize="20sp"/>
                    </LinearLayout>

                    <!-- Disaster Map -->
                    <LinearLayout
                        android:id="@+id/cardMap"
                        android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:background="@drawable/bg_nav_card"
                        android:orientation="horizontal" android:gravity="center_vertical"
                        android:padding="16dp" android:layout_marginStart="6dp"
                        android:clickable="true" android:focusable="true">
                        <FrameLayout
                            android:layout_width="40dp" android:layout_height="40dp"
                            android:background="@drawable/bg_stat_icon_blue"
                            android:layout_marginEnd="12dp">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:layout_gravity="center" android:text="📍" android:textSize="18sp"/>
                        </FrameLayout>
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_weight="1" android:orientation="vertical">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="Disaster Map"
                                android:textColor="@color/colorTextPrimary"
                                android:textSize="14sp" android:textStyle="bold"/>
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="View and manage map points"
                                android:textColor="@color/colorTextMuted" android:textSize="11sp"/>
                        </LinearLayout>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="›" android:textColor="@color/colorTextMuted" android:textSize="20sp"/>
                    </LinearLayout>
                </LinearLayout>

                <!-- Row 2 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <!-- Donations -->
                    <LinearLayout
                        android:id="@+id/cardDonations"
                        android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:background="@drawable/bg_nav_card"
                        android:orientation="horizontal" android:gravity="center_vertical"
                        android:padding="16dp" android:layout_marginEnd="6dp"
                        android:clickable="true" android:focusable="true">
                        <FrameLayout
                            android:layout_width="40dp" android:layout_height="40dp"
                            android:background="@drawable/bg_stat_icon_purple"
                            android:layout_marginEnd="12dp">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:layout_gravity="center" android:text="💙" android:textSize="18sp"/>
                        </FrameLayout>
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_weight="1" android:orientation="vertical">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="Donations"
                                android:textColor="@color/colorTextPrimary"
                                android:textSize="14sp" android:textStyle="bold"/>
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="View all donation records"
                                android:textColor="@color/colorTextMuted" android:textSize="11sp"/>
                        </LinearLayout>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="›" android:textColor="@color/colorTextMuted" android:textSize="20sp"/>
                    </LinearLayout>

                    <!-- Users -->
                    <LinearLayout
                        android:id="@+id/cardUsers"
                        android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:background="@drawable/bg_nav_card"
                        android:orientation="horizontal" android:gravity="center_vertical"
                        android:padding="16dp" android:layout_marginStart="6dp"
                        android:clickable="true" android:focusable="true">
                        <FrameLayout
                            android:layout_width="40dp" android:layout_height="40dp"
                            android:background="@drawable/bg_stat_icon_green"
                            android:layout_marginEnd="12dp">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:layout_gravity="center" android:text="👥" android:textSize="18sp"/>
                        </FrameLayout>
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_weight="1" android:orientation="vertical">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="Users"
                                android:textColor="@color/colorTextPrimary"
                                android:textSize="14sp" android:textStyle="bold"/>
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="View all registered users"
                                android:textColor="@color/colorTextMuted" android:textSize="11sp"/>
                        </LinearLayout>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="›" android:textColor="@color/colorTextMuted" android:textSize="20sp"/>
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- Logout button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnLogout"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="Logout"
                android:textSize="14sp"
                android:textColor="@color/colorTextSecondary"
                app:backgroundTint="@color/colorSurface"
                app:strokeColor="@color/colorBorder"
                app:strokeWidth="1dp"
                app:cornerRadius="10dp"
                android:layout_marginTop="24dp"/>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Admin bottom nav -->
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@color/colorSurface"
        app:menu="@menu/bottom_nav_admin"
        app:itemIconTint="@color/bottom_nav_color"
        app:itemTextColor="@color/bottom_nav_color"
        app:labelVisibilityMode="labeled"
        app:elevation="8dp"/>

</androidx.coordinatorlayout.widget.CoordinatorLayout>