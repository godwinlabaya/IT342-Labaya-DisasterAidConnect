<?xml version="1.0" encoding="utf-8"?>
<!--
    dialog_donate.xml
    Bottom sheet dialog shown when user taps "Donate" on a disaster point.
    Mirrors the web DonationModal but with:
      - Amount input field
      - GCash deep-link button (instead of copy-number)
    Displayed via BottomSheetDialog in DisasterMapActivity.
-->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_bottom_sheet"
    android:paddingBottom="32dp">

    <!-- Drag handle -->
    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:background="@drawable/bg_drag_handle"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="20dp"/>

    <!-- Heart icon + title -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:layout_marginBottom="20dp">

        <!-- Blue heart icon circle — mirrors web donation-modal-icon-wrap -->
        <FrameLayout
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:background="@drawable/bg_donation_icon"
            android:layout_gravity="center"
            android:layout_marginBottom="14dp">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="💙"
                android:textSize="22sp"/>
        </FrameLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Donate via GCash"
            android:textColor="@color/colorTextPrimary"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_gravity="center"
            android:layout_marginBottom="4dp"/>

        <!-- Disaster title — set programmatically -->
        <TextView
            android:id="@+id/tvDonateDisasterTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=""
            android:textColor="@color/colorTextMuted"
            android:textSize="13sp"
            android:fontStyle="italic"
            android:layout_gravity="center"
            android:layout_marginBottom="2dp"/>

        <!-- Added by — set programmatically -->
        <TextView
            android:id="@+id/tvDonateAddedBy"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=""
            android:textColor="@color/colorTextSecondary"
            android:textSize="12sp"
            android:layout_gravity="center"/>
    </LinearLayout>

    <!-- Amount input section -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:layout_marginBottom="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="DONATION AMOUNT"
            android:textColor="@color/colorTextMuted"
            android:textSize="11sp"
            android:textStyle="bold"
            android:letterSpacing="0.08"
            android:layout_marginBottom="8dp"/>

        <!-- Amount row: ₱ prefix + EditText -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:orientation="horizontal"
            android:background="@drawable/bg_card"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:text="₱"
                android:textColor="@color/colorTextMuted"
                android:textSize="18sp"
                android:textStyle="bold"
                android:gravity="center"
                android:paddingStart="16dp"
                android:paddingEnd="12dp"
                android:background="@color/colorBorderLight"/>

            <EditText
                android:id="@+id/etDonationAmount"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:hint="Enter amount"
                android:textColorHint="@color/colorTextMuted"
                android:textColor="@color/colorTextPrimary"
                android:textSize="20sp"
                android:textStyle="bold"
                android:inputType="numberDecimal"
                android:background="@android:color/transparent"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:gravity="center_vertical"
                android:maxLines="1"/>
        </LinearLayout>

        <!-- Quick amount chips -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="10dp">

            <TextView
                android:id="@+id/chip50"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:text="₱50"
                android:gravity="center"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="@color/colorTextSecondary"
                android:background="@drawable/bg_card"
                android:layout_marginEnd="6dp"/>

            <TextView
                android:id="@+id/chip100"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:text="₱100"
                android:gravity="center"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="@color/colorTextSecondary"
                android:background="@drawable/bg_card"
                android:layout_marginEnd="6dp"/>

            <TextView
                android:id="@+id/chip250"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:text="₱250"
                android:gravity="center"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="@color/colorTextSecondary"
                android:background="@drawable/bg_card"
                android:layout_marginEnd="6dp"/>

            <TextView
                android:id="@+id/chip500"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:text="₱500"
                android:gravity="center"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="@color/colorTextSecondary"
                android:background="@drawable/bg_card"/>
        </LinearLayout>
    </LinearLayout>

    <!-- GCash number display -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:layout_marginBottom="20dp">

        <!-- GCash info card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card"
            android:padding="14dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Send to GCash number:"
                android:textColor="@color/colorTextMuted"
                android:textSize="12sp"
                android:layout_marginBottom="6dp"/>

            <TextView
                android:id="@+id/tvGcashNumberDisplay"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="—"
                android:textColor="@color/colorTextPrimary"
                android:textSize="22sp"
                android:textStyle="bold"
                android:letterSpacing="0.05"/>
        </LinearLayout>

        <!-- Notice banner: mirrors web donation-notice yellow box -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="@drawable/bg_mute_banner"
            android:padding="12dp"
            android:layout_marginTop="10dp"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📱"
                android:textSize="16sp"
                android:layout_marginEnd="8dp"/>

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Tapping Donate will open your GCash app and record this donation."
                android:textColor="#92400e"
                android:textSize="12sp"
                android:lineSpacingMultiplier="1.3"/>
        </LinearLayout>
    </LinearLayout>

    <!-- Error message (hidden by default) -->
    <TextView
        android:id="@+id/tvDonateError"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text=""
        android:textColor="@color/colorError"
        android:textSize="12sp"
        android:background="@drawable/bg_badge_critical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:layout_marginBottom="12dp"
        android:visibility="gone"/>

    <!-- Action buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="24dp"
        android:paddingEnd="24dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnDonateCancel"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:text="Cancel"
            android:textSize="14sp"
            android:textColor="@color/colorTextSecondary"
            app:backgroundTint="@color/colorSurface"
            app:strokeColor="@color/colorBorder"
            app:strokeWidth="1dp"
            app:cornerRadius="10dp"
            android:layout_marginEnd="10dp"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnDonateConfirm"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="2"
            android:text="💙  Donate via GCash"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            app:backgroundTint="@color/colorNavy"
            app:cornerRadius="10dp"/>
    </LinearLayout>

</LinearLayout>