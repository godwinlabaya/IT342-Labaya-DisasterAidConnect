<?xml version="1.0" encoding="utf-8"?>
<!--
    layout_mute_bell_panel.xml
    Notification panel that slides in when the bell icon is tapped.
    Mirrors web MuteNotificationBell.js panel UI.
    Inflated and attached to the top bar in DisasterMapActivity.
-->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="280dp"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_card_elevated"
    android:elevation="8dp">

    <!-- Panel header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="12dp"
        android:background="@color/colorSurface">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Notifications"
            android:textColor="@color/colorTextPrimary"
            android:textSize="15sp"
            android:textStyle="bold"/>

        <TextView
            android:id="@+id/tvBellPanelClose"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:text="✕"
            android:gravity="center"
            android:textColor="@color/colorTextMuted"
            android:textSize="14sp"
            android:background="@drawable/bg_card"
            android:clickable="true"
            android:focusable="true"/>
    </LinearLayout>

    <!-- Divider -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/colorBorder"/>

    <!-- Mute notification item (shown when muted) -->
    <LinearLayout
        android:id="@+id/layoutMuteItem"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="14dp"
        android:visibility="gone">

        <!-- Red ban icon -->
        <FrameLayout
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/bg_badge_critical"
            android:layout_marginEnd="12dp"
            android:layout_marginTop="2dp">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="🔇"
                android:textSize="16sp"/>
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="You have been muted by an admin"
                android:textColor="@color/colorTextPrimary"
                android:textSize="13sp"
                android:textStyle="bold"
                android:layout_marginBottom="4dp"/>

            <!-- Mute reason — set programmatically -->
            <LinearLayout
                android:id="@+id/layoutMuteReason"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="4dp"
                android:visibility="gone">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="💬 "
                    android:textSize="12sp"/>
                <TextView
                    android:id="@+id/tvMuteReasonText"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text=""
                    android:textColor="@color/colorTextSecondary"
                    android:textSize="12sp"
                    android:fontStyle="italic"/>
            </LinearLayout>

            <!-- Restriction lifts / indefinite -->
            <TextView
                android:id="@+id/tvMuteUntil"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=""
                android:textColor="@color/colorTextMuted"
                android:textSize="11sp"
                android:layout_marginBottom="8dp"/>

            <!-- Warning notice box — mirrors web mnb-item-notice -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:background="@drawable/bg_badge_critical"
                android:padding="8dp"
                android:gravity="center_vertical">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="⚠️  "
                    android:textSize="11sp"/>
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="You cannot add new disaster points until this mute is lifted."
                    android:textColor="@color/colorError"
                    android:textSize="11sp"
                    android:lineSpacingMultiplier="1.3"/>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- Empty state (shown when NOT muted) -->
    <LinearLayout
        android:id="@+id/layoutBellEmpty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="24dp">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🔔"
            android:textSize="28sp"
            android:layout_gravity="center"
            android:layout_marginBottom="8dp"/>
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="No new notifications"
            android:textColor="@color/colorTextMuted"
            android:textSize="13sp"
            android:layout_gravity="center"/>
    </LinearLayout>

</LinearLayout>