<?xml version="1.0" encoding="utf-8"?>
<!-- item_dashboard_row.xml — used by DashboardActivity for requests and donations list -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingStart="4dp"
    android:paddingEnd="8dp"
    android:paddingTop="14dp"
    android:paddingBottom="14dp"
    android:background="@drawable/bg_list_item">

    <!-- Severity dot -->
    <View
        android:id="@+id/severityDot"
        android:layout_width="8dp"
        android:layout_height="8dp"
        android:background="@drawable/bg_dot"
        android:layout_marginEnd="12dp"/>

    <!-- Title + date -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Disaster Title"
            android:textColor="@color/colorTextPrimary"
            android:textSize="14sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end"/>

        <TextView
            android:id="@+id/tvDate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="May 24, 2026"
            android:textColor="@color/colorTextMuted"
            android:textSize="11sp"
            android:layout_marginTop="3dp"/>
    </LinearLayout>

    <!-- Severity badge -->
    <TextView
        android:id="@+id/tvSeverity"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="High"
        android:textSize="11sp"
        android:textStyle="bold"
        android:textColor="@color/colorSeverityHigh"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:paddingTop="3dp"
        android:paddingBottom="3dp"
        android:background="@drawable/bg_badge_high"
        android:layout_marginEnd="6dp"/>

    <!-- Status badge -->
    <TextView
        android:id="@+id/tvStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Active"
        android:textSize="11sp"
        android:textStyle="bold"
        android:textColor="@color/colorSuccess"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:paddingTop="3dp"
        android:paddingBottom="3dp"
        android:background="@drawable/bg_badge_active"/>

    <!-- Chevron -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="›"
        android:textColor="@color/colorTextMuted"
        android:textSize="18sp"
        android:layout_marginStart="6dp"/>
</LinearLayout>